# ---------------------------------------------------------------------------
# Copy to .env.local for local dev, and set the same keys in
# Vercel -> Project -> Settings -> Environment Variables for production.
# ---------------------------------------------------------------------------

# Postgres connection string. Works with Neon, Vercel Postgres, Supabase
# (use the pooled/pgbouncer URL), Railway, RDS, or any standard Postgres.
#
# If you attached Neon or Vercel Postgres through the Vercel integration, this
# is injected for you — under DATABASE_URL, POSTGRES_URL, DATABASE_URL_UNPOOLED
# or POSTGRES_URL_NON_POOLING depending on the integration. Any of those four
# is picked up automatically, so there is usually nothing to set here.
DATABASE_URL="postgres://user:password@host:5432/dbname"

# Set to 1 only when connecting to a local Postgres without TLS.
# PGSSL_DISABLE=0

# ---- Admin dashboard login (service.powertechniquena.com/admin) ----
# The password you type at the login screen.
ADMIN_PASSWORD="change-me-to-something-long-and-random"

# Signs the admin session cookie. Any long random string.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET="change-me-to-a-64-char-random-hex-string"

# ---- Email notifications on form submission ----
# Resend API key (https://resend.com -> API Keys).
RESEND_API_KEY=""

# Must be a domain verified in Resend.
FROM_EMAIL="Power Technique Service <noreply@service.powertechniquena.com>"

# Comma-separated list of everyone who should be notified on a new submission.
NOTIFY_EMAILS="ryan@clickovation.com"

# Optional: separate recipients per request type. Falls back to NOTIFY_EMAILS.
# NOTIFY_EMAILS_PARTS="parts@example.com"
# NOTIFY_EMAILS_SERVICE="service@example.com"

# Optional: salt used when hashing visitor IPs before storage.
IP_HASH_SALT="change-me-too"
